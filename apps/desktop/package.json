{
  "name": "@agentscope/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AgentScope Windows desktop console.",
  "author": "dwgx",
  "type": "module",
  "os": [
    "win32"
  ],
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build && concurrently -k -n vite,electron \"vite --config vite.renderer.config.ts --host 127.0.0.1 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:electron": "npm run build && electron .",
    "build": "node ../../scripts/clean-build-outputs.mjs --desktop && tsc -b && vite build --config vite.renderer.config.ts",
    "typecheck": "tsc -b --pretty false",
    "package": "npm run package:dir",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "package:dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@agentscope/core": "0.1.0",
    "@agentscope/i18n": "0.1.0",
    "@agentscope/shared": "0.1.0",
    "i18next": "^26.3.1",
    "lucide-react": "^0.561.0",
    "motion": "^12.40.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "vite": "^7.2.6",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "dev.agentscope.desktop",
    "productName": "AgentScope",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "src/preload/preload.cjs",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable-${arch}.${ext}"
    }
  }
}
